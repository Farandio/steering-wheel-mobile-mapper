<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PXN V9 Gen 2 - BUSSID Keymapper"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDeviceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Memeriksa status perangkat..."
        android:padding="12dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvServiceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Accessibility Service: Memeriksa..."
        android:padding="12dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGrantAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Buka Pengaturan Accessibility"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnGrantOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Izinkan Display Over Other Apps"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCalibrateHardware"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔧 Kalibrasi Setir &amp; Pedal (Auto-Detect Axis)"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00838F"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnToggleAdb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ ADB Wireless Debugging (0ms Zero Delay)"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#455A64"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnToggleOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mulai Layanan Keymapper (Overlay)"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

</LinearLayout>
