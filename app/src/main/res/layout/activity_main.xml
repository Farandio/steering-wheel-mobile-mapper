<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151520"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar Header Senada GUI Python -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#20202E"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🕹️ BUSSID STEERING &amp; H-SHIFTER MAPPER"
                android:textColor="#06D6A0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOBILE PRO"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#3A86FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Hardware & Steering Wheel Device Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1E1E2D"
            app:strokeColor="#2C3848"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 STATUS STEERING WHEEL &amp; SHIFTER"
                    android:textColor="#FCA311"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDeviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mencari perangkat kemudi..."
                    android:textColor="#00FF66"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2C3848"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ SERVICE INJECTION STATUS"
                    android:textColor="#A0C4FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Service: Memeriksa..."
                    android:textColor="#EDF2F4"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permission Setup Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1E1E2D"
            app:strokeColor="#2C3848"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔐 IZIN SISTEM (WAJIB DIAKTIFKAN)"
                    android:textColor="#FCA311"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="1. Izinkan Accessibility Service (Injeksi Sentuhan)"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#4F5D75"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="2. Izinkan Tampil di Atas Aplikasi Lain"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#4F5D75"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= 3 PEDAL CALIBRATION & LIVE DETECT (PERSIS GAMBAR) ================= -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1E1E2D"
            app:strokeColor="#2C3848"
            app:strokeWidth="1dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedal Gas &amp; Rem Otomatis Mengirim Input ke Game:"
                    android:textColor="#FCA311"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Nilai Raw Semua Axis -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="6dp"
                    app:cardBackgroundColor="#151520"
                    app:strokeColor="#06D6A0"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nilai Raw Semua Axis:"
                            android:textColor="#06D6A0"
                            android:textSize="10sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvRawAllAxes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="X: 0 | Y: 0 | Z: 0 | R: 0 | U: 0 | V: 0"
                            android:textColor="#EDF2F4"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 1. PEDAL GAS (Throttle) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#151520"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 PEDAL GAS (Throttle)"
                        android:textColor="#06D6A0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ProgressBar
                            android:id="@+id/pbGas"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="18dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#06D6A0"
                            android:background="#333333" />

                        <TextView
                            android:id="@+id/tvGasPct"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#06D6A0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvGasAxisLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Axis: GAS (22)"
                            android:textColor="#EDF2F4"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetectGas"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⚡ Auto-Detect"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#4F5D75"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:layout_marginEnd="4dp"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetGasRest"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Lepas"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#3A86FF"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:layout_marginEnd="4dp"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetGasPressed"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Injak"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#3A86FF"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. PEDAL REM (Brake) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#151520"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 PEDAL REM (Brake)"
                        android:textColor="#EF233C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ProgressBar
                            android:id="@+id/pbBrake"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="18dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#EF233C"
                            android:background="#333333" />

                        <TextView
                            android:id="@+id/tvBrakePct"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#EF233C"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBrakeAxisLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Axis: BRAKE (23)"
                            android:textColor="#EDF2F4"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetectBrake"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⚡ Auto-Detect"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#4F5D75"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:layout_marginEnd="4dp"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetBrakeRest"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Lepas"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#3A86FF"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:layout_marginEnd="4dp"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetBrakePressed"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Injak"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#3A86FF"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. PEDAL KOPLING (Clutch) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#151520"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔵 PEDAL KOPLING (Clutch)"
                        android:textColor="#3A86FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ProgressBar
                            android:id="@+id/pbClutch"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="18dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#3A86FF"
                            android:background="#333333" />

                        <TextView
                            android:id="@+id/tvClutchPct"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#3A86FF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvClutchAxisLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Axis: Y (1)"
                            android:textColor="#EDF2F4"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetectClutch"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⚡ Auto-Detect"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#4F5D75"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:layout_marginEnd="4dp"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetClutchRest"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Lepas"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#3A86FF"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:layout_marginEnd="4dp"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetClutchPressed"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Set Injak"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            app:backgroundTint="#3A86FF"
                            app:cornerRadius="4dp"
                            android:paddingHorizontal="6dp"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Button: Start Keymapper -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🎮 MINIMIZE &amp; BUKA GAME (UNTUK MAIN)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#111111"
            app:backgroundTint="#06D6A0"
            app:cornerRadius="10dp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
